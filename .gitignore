.env
__pycache__/
*.pyc
# .claude is local config, EXCEPT skills/ - CLAUDE.md points at those procedures
.claude/*
!.claude/skills/

# generated sync state / enrichment queues
/av/
/investing/
/tw/
dart/sync_state.json
dart/pending.json
# edinet.py caches, re-made on demand (the code list needs no key; the daily-list cache only saves requests)
edinet/codes.json
edinet/index.json

# generated audit report (rebuilt by every graph_build)
graph/verification.json

# i18n.py pending: translation work files (chunks, agent outputs) — not committed
i18n/pending/

# market/*.py download caches (SEC data-set zips, Epoch zips, same-day responses): re-made on demand, never published
market/cache/
# market/health.py and market/selftest.py output, re-made every night (local only, never published):
# which phone alerts were already pushed today, the latest health check, the latest regression-test result
market/health_state.json
market/health.json
market/selftest_result.json

# scratch output of local verification runs (screenshots, build logs)
/tmp/
